<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Solar System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

    <h1 class="text-center bg-primary p-5 text-white">The Solar System</h1>

    <%- include("partials/nav.ejs") %>

    <div class="main-content">
        <div class="info-section">
            <h2> <%=planet_name%> </h2>
            <%=planetInfo.description%>

            <br><br>
            <p>Distance from Sun: <%=planetInfo.distanceFromSun%></p>
            <p>Year Length: <%=planetInfo.yearLength%></p>
            <p>Radius: <%=planetInfo.radius%></p>
            <p>One Earth Day: <%=planetInfo.oneEarthDay%></p>
            <p>Number of Moons: <%=planetInfo.moons%></p>
        </div>

        <br>

        <div class="image-section">
            <img src="<%=planetInfo.image%>" width="300">
        </div>
    </div>

    <%- include("partials/footer.ejs") %>
    
</body>
</html>